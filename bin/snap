#!/bin/sh
# Render a reference page at desktop, dark, and phone widths with headless Chrome.
# Usage: bin/snap reference/index.html [outdir]
set -e
page="$(cd "$(dirname "$1")" && pwd)/$(basename "$1")"
out="${2:-/tmp/henry-snap}"; mkdir -p "$out"
chrome="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
common="--headless=new --disable-gpu --hide-scrollbars"
"$chrome" $common --window-size=1280,2000 --screenshot="$out/desktop.png" "file://$page" 2>/dev/null
"$chrome" $common --force-dark-mode --window-size=1280,2000 --screenshot="$out/dark.png" "file://$page" 2>/dev/null
# Chrome clamps the window to 500px wide, so phone width goes through an iframe.
printf '<!doctype html><body style="margin:0;background:#888"><iframe src="file://%s" style="width:390px;height:2600px;border:0;display:block"></iframe></body>' "$page" > "$out/frame.html"
"$chrome" $common --window-size=500,2600 --screenshot="$out/phone.png" "file://$out/frame.html" 2>/dev/null
echo "$out"
