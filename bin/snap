#!/bin/sh
# Render a reference page at phone, tablet, laptop, desktop, and dark with headless Chrome.
# Usage: bin/snap reference/index.html [outdir]
set -e
page="$(cd "$(dirname "$1")" && pwd)/$(basename "$1")"
out="${2:-/tmp/henry-snap}"; mkdir -p "$out"
chrome="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
common="--headless=new --disable-gpu --hide-scrollbars --virtual-time-budget=5000"
"$chrome" $common --window-size=820,1400 --screenshot="$out/tablet.png" "file://$page" 2>/dev/null
"$chrome" $common --window-size=1280,1400 --screenshot="$out/laptop.png" "file://$page" 2>/dev/null
"$chrome" $common --window-size=1920,1200 --screenshot="$out/desktop.png" "file://$page" 2>/dev/null
"$chrome" $common --force-dark-mode --window-size=1280,1400 --screenshot="$out/dark.png" "file://$page" 2>/dev/null
# Chrome clamps the window to 500px wide, so phone width goes through an iframe.
printf '<!doctype html><body style="margin:0;background:#888"><iframe src="file://%s" style="width:390px;height:1400px;border:0;display:block"></iframe></body>' "$page" > "$out/frame.html"
"$chrome" $common --window-size=500,1400 --screenshot="$out/phone.png" "file://$out/frame.html" 2>/dev/null
echo "$out"
